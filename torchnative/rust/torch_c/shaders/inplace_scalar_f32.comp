#version 450

// `aten.mul_.Scalar`, `aten.fill_.Scalar` and `aten.zero_.default` for f32,
// written into the receiver's own buffer:
//
//     p2 == 0:  a[i] = a[i] * s     (mul_)
//     p2 == 1:  a[i] = s            (fill_, and zero_ with s = 0)
//
// One binding, because there is no second operand: the scalar rides in the
// push constants as its float32 bit pattern, exactly as `scalar_f32.comp` and
// `fill_f32.comp` take theirs.
//
// Sound for the same single reason as `inplace_add_f32.comp`: `vulkan.rs`
// dispatches this only after proving the receiver's `Arc<VkBuffer>` has one
// live reference, so no alias can observe the write (docs/devices/VULKAN11.md §2).
//
// `zero_` is `fill_` with `s = 0.0` rather than its own arm: the two differ in
// no bit of behaviour, and a second kernel would be a second thing to keep
// true. `mul_` stays a multiply for `scalar_f32.comp`'s reason -- the
// reciprocal rewrite is a rounding upstream does not do.

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) buffer A { float a[]; };

// n: elements, p1: the scalar's float32 bits, p2: 0 = multiply, 1 = fill
layout(push_constant) uniform Push { uint n; uint p1; uint p2; uint p3; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float s = uintBitsToFloat(pc.p1);
    a[i] = (pc.p2 == 0u) ? (a[i] * s) : s;
}
