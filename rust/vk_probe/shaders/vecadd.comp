#version 450

// c[i] = a[i] + b[i], f32. One float add per invocation and nothing else, so a
// mismatch here can only be the plumbing -- buffer binding, memory visibility,
// dispatch size -- and never accumulation order. IEEE-754 single addition is
// exactly specified, so this one is checked bit-for-bit.

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly  buffer A { float a[]; };
layout(std430, set = 0, binding = 1) readonly  buffer B { float b[]; };
layout(std430, set = 0, binding = 2) writeonly buffer C { float c[]; };

layout(push_constant) uniform Push { uint n; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    c[i] = a[i] + b[i];
}
