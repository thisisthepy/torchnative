#version 450

// `aten.add.Tensor` for f32, same shape, alpha == 1: c[i] = a[i] + b[i].
//
// Copied deliberately from `crates/vulkan_probe/shaders/vecadd.comp` rather than
// shared with it. The probe answers "can a compute shader run at all" and must
// keep answering that if this file changes; a shared file would make one
// question's edit silently redefine the other's evidence.
//
// One float add per invocation and nothing else, so a mismatch can only be the
// plumbing -- buffer binding, memory visibility, dispatch size -- and never
// accumulation order. IEEE-754 single addition is exactly specified, so the
// test compares this bit-for-bit against the CPU kernel rather than within a
// tolerance.

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly  buffer A { float a[]; };
layout(std430, set = 0, binding = 1) readonly  buffer B { float b[]; };
layout(std430, set = 0, binding = 2) writeonly buffer C { float c[]; };

layout(push_constant) uniform Push { uint n; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    c[i] = a[i] + b[i];
}
